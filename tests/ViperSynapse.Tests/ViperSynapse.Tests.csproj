<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 builds its own app host. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>ViperSynapse.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(TestSdkVersion)" />
    <PackageReference Include="xunit.v3" Version="$(XunitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVersion)" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="$(TimeProviderTestingVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ViperSynapse.Core\ViperSynapse.Core.csproj" />
    <ProjectReference Include="..\..\src\ViperSynapse.Hardware\ViperSynapse.Hardware.csproj" />
    <ProjectReference Include="..\..\src\ViperSynapse.Service\ViperSynapse.Service.csproj" />
    <ProjectReference Include="..\..\src\ViperSynapse.App\ViperSynapse.App.csproj" />
  </ItemGroup>

</Project>
