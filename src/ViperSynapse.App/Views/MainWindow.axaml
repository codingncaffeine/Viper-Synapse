<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ViperSynapse.App.ViewModels"
        xmlns:views="using:ViperSynapse.App.Views"
        x:Class="ViperSynapse.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Viper Synapse"
        Icon="/Assets/icon.png"
        Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="vm:DeviceViewModel"><views:DeviceView /></DataTemplate>
        <DataTemplate DataType="vm:LinkedGamesViewModel"><views:LinkedGamesView /></DataTemplate>
        <DataTemplate DataType="vm:MacrosViewModel"><views:MacrosView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <Grid RowDefinitions="34,34,*,Auto">
            <!-- Tabs: SYNAPSE, the devices, LINKED GAMES, MACRO, SETTINGS. Dragging the bar moves the window. -->
            <Border Grid.Row="0" Background="{StaticResource TopBarBrush}" Name="TopBar">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Classes="chrome" Name="MinimizeButton" ToolTip.Tip="Minimize">
                            <Path Data="M0,0 L10,0" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
                        </Button>
                        <Button Classes="chrome" Name="MaximizeButton" ToolTip.Tip="Maximize">
                            <Rectangle Width="10" Height="10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
                        </Button>
                        <Button Classes="chrome close" Name="CloseButton" ToolTip.Tip="Close">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
                        </Button>
                    </StackPanel>
                    <ListBox Classes="topTabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                             HorizontalAlignment="Left" Margin="6,0,0,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TabViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Panel Width="20" Height="20" VerticalAlignment="Center">
                                        <Ellipse Fill="{StaticResource GreenBrush}" IsVisible="{Binding Icon, Converter={x:Static views:Converters.TabInDisc}}" />
                                        <Image Source="/Assets/icon.png" Width="20" Height="20"
                                               IsVisible="{Binding Icon, Converter={x:Static views:Converters.Is}, ConverterParameter=Synapse}" />
                                        <TextBlock Text="{Binding Icon, Converter={x:Static views:Converters.TabGlyph}}" FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Icon, Converter={x:Static views:Converters.TabGlyphBrush}}" />
                                    </Panel>
                                    <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Back, forward, refresh; the page title; help. -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" Background="{StaticResource PageBrush}">
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" Spacing="2">
                    <Button Classes="nav" Content="‹" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="Back" />
                    <Button Classes="nav" Content="›" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="Forward" />
                    <Button Classes="nav" Content="⟳" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh" FontSize="16" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="title" Text="{Binding Title}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button Classes="nav" Content="?" Name="HelpButton" ToolTip.Tip="Help and source code" FontWeight="Bold" />
                </StackPanel>
            </Grid>

            <ContentControl Grid.Row="2" Content="{Binding SelectedTab}" />

            <Border Grid.Row="3" Background="#3A1214" IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Padding="12,6">
                <TextBlock Text="{Binding Problem}" Foreground="#FFB4B4" TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!-- Resize edges: the window draws its own frame, so it offers its own handles. -->
        <Border Name="EdgeLeft" Width="5" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" />
        <Border Name="EdgeRight" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" />
        <Border Name="EdgeBottom" Height="5" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" />
        <Border Name="EdgeBottomRight" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" />
        <Border Name="EdgeBottomLeft" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" />
    </Panel>
</Window>
