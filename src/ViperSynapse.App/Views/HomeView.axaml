<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ViperSynapse.App.ViewModels"
             xmlns:views="using:ViperSynapse.App.Views"
             xmlns:devices="using:ViperSynapse.Core.Devices"
             x:Class="ViperSynapse.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <Grid RowDefinitions="44,*">
        <ListBox Classes="pills" HorizontalAlignment="Center" VerticalAlignment="Center"
                 ItemsSource="{x:Static vm:HomeViewModel.Pages}" SelectedItem="{Binding SelectedPage}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- DASHBOARD: devices, then modules. -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowDashboard}">
            <StackPanel Margin="16,4,16,16" Spacing="8">
                <TextBlock Classes="section" Text="▾  DEVICES" />
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceViewModel">
                            <Button Classes="deviceCard" Margin="0,0,8,8" Click="OpenDevice">
                                <StackPanel Spacing="6">
                                    <Panel Height="110">
                                        <Image Source="{Binding Photo}" Stretch="Uniform"
                                               IsVisible="{Binding Photo, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <Image Source="/Assets/icon.png" Width="64" Height="64"
                                               IsVisible="{Binding Photo, Converter={x:Static ObjectConverters.IsNull}}" />
                                    </Panel>
                                    <TextBlock Text="{Binding Title}" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ProfileName}" FontSize="10" Classes="green" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="section" Text="▾  MODULES" Margin="0,10,0,0" />
                <WrapPanel>
                    <Button Classes="moduleCard" Margin="0,0,8,8" Click="OpenLinkedGames">
                        <StackPanel Spacing="14">
                            <Panel Width="64" Height="64">
                                <Ellipse Fill="{StaticResource GreenBrush}" />
                                <TextBlock Text="◉◉" FontSize="22" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                            <TextBlock Text="LINKED GAMES" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="moduleCard" Margin="0,0,8,8" Click="OpenMacros">
                        <StackPanel Spacing="14">
                            <Panel Width="64" Height="64">
                                <Ellipse Fill="{StaticResource GreenBrush}" />
                                <TextBlock Text="M" FontSize="30" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                            <TextBlock Text="MACRO" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="moduleCard" Margin="0,0,8,8" Click="OpenSettings">
                        <StackPanel Spacing="14">
                            <Panel Width="64" Height="64">
                                <Ellipse Fill="{StaticResource GreenBrush}" />
                                <TextBlock Text="⚙" FontSize="30" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                            <TextBlock Text="SETTINGS" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- DEVICES & MODULES: what is installed. -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowModules}">
            <StackPanel Width="760" Margin="0,10" Spacing="10">
                <TextBlock Classes="heading" Text="INSTALLED" FontSize="16" />
                <Border Background="{StaticResource PanelBrush}" Padding="0,4">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceViewModel">
                                    <Grid ColumnDefinitions="40,*,Auto" Height="44" Margin="12,0">
                                        <TextBlock Text="▦" FontSize="18" Foreground="#CCCCCC" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ShortName}" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Details}" Classes="caption" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="40,*,Auto" Height="44" Margin="12,0">
                            <Panel Width="24" Height="24"><Ellipse Fill="{StaticResource GreenBrush}" /><TextBlock Text="◉◉" FontSize="8" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" /></Panel>
                            <TextBlock Grid.Column="1" Text="Linked Games" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Version, StringFormat='Version {0}'}" Classes="caption" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="40,*,Auto" Height="44" Margin="12,0">
                            <Panel Width="24" Height="24"><Ellipse Fill="{StaticResource GreenBrush}" /><TextBlock Text="M" FontSize="12" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" /></Panel>
                            <TextBlock Grid.Column="1" Text="Macro" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Version, StringFormat='Version {0}'}" Classes="caption" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- GLOBAL SHORTCUTS: one card with the list and the dashed ADD A SHORTCUT row; the editor beside it. -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowShortcuts}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="12" Margin="16,14"
                        DataContext="{Binding Shortcuts}" x:DataType="vm:ShortcutsViewModel">
                <Border Background="#151515" Width="432" Padding="14,16" VerticalAlignment="Top" CornerRadius="2">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="SHORTCUTS" Foreground="{StaticResource GreenBrush}" FontSize="13" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="flat" Content="+" FontSize="20" FontWeight="Light" ToolTip.Tip="Add a shortcut" Command="{Binding AddCommand}" />
                        </Grid>
                        <TextBlock Foreground="#DDDDDD" FontSize="12" TextWrapping="Wrap"
                                   Text="Global shortcuts are custom key combinations that work across all device profiles. This feature only works for Viper Synapse-enabled device inputs." />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShortcutRow">
                                    <Border Background="#1E1E1E" Margin="0,0,0,6" Padding="12,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Keys}" Foreground="#FFFFFF" FontSize="13" />
                                                <TextBlock Foreground="#999999" FontSize="11">
                                                    <Run Text="{Binding Category}" /><Run Text=":  " /><Run Text="{Binding Function}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="flat" Content="✎" ToolTip.Tip="Edit"
                                                    Command="{Binding $parent[ItemsControl].((vm:ShortcutsViewModel)DataContext).ChangeCommand}" CommandParameter="{Binding}" />
                                            <Button Grid.Column="2" Classes="flat" Content="🗑" ToolTip.Tip="Delete"
                                                    Command="{Binding $parent[ItemsControl].((vm:ShortcutsViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Command="{Binding AddCommand}" Background="Transparent" Padding="0" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" Cursor="Hand" Margin="0,4,0,8">
                            <Panel Height="50">
                                <Rectangle Stroke="#7A7A7A" StrokeThickness="1" StrokeDashArray="4,3" />
                                <TextBlock Text="ADD A SHORTCUT" Foreground="#DDDDDD" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- The keys, then the function from the key-binding editor (its SAVE stores the shortcut). -->
                <StackPanel Spacing="8" IsVisible="{Binding Editing}" Width="330">
                    <Border Background="{StaticResource PanelBrush}" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="caption" Text="DEVICE" />
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding EditDevice}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DeviceViewModel">
                                        <TextBlock Text="{Binding ShortName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="caption" Text="KEYS, HELD TOGETHER (TWO OR THREE)" />
                            <ComboBox ItemsSource="{Binding KeyChoices}" SelectedItem="{Binding Key1}" HorizontalAlignment="Stretch" PlaceholderText="First key">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="devices:DeviceKey">
                                        <TextBlock><Run Text="{Binding Number}" /><Run Text="  " /><Run Text="{Binding Label}" /></TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox ItemsSource="{Binding KeyChoices}" SelectedItem="{Binding Key2}" HorizontalAlignment="Stretch" PlaceholderText="Second key">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="devices:DeviceKey">
                                        <TextBlock><Run Text="{Binding Number}" /><Run Text="  " /><Run Text="{Binding Label}" /></TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox ItemsSource="{Binding KeyChoices}" SelectedItem="{Binding Key3}" HorizontalAlignment="Stretch" PlaceholderText="Third key (optional)">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="devices:DeviceKey">
                                        <TextBlock><Run Text="{Binding Number}" /><Run Text="  " /><Run Text="{Binding Label}" /></TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding Problem}" Foreground="#E5484D" FontSize="12" TextWrapping="Wrap"
                                       IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Border>
                    <views:BindingFlyout DataContext="{Binding Editor}" IsVisible="{Binding $parent[StackPanel].((vm:ShortcutsViewModel)DataContext).Editing}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
