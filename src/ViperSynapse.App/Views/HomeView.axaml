<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ViperSynapse.App.ViewModels"
             x:Class="ViperSynapse.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <Grid RowDefinitions="44,*">
        <ListBox Classes="pills" HorizontalAlignment="Center" VerticalAlignment="Center"
                 ItemsSource="{x:Static vm:HomeViewModel.Pages}" SelectedItem="{Binding SelectedPage}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- DASHBOARD: devices, then modules. -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowDashboard}">
            <StackPanel Margin="16,4,16,16" Spacing="8">
                <TextBlock Classes="section" Text="▾  DEVICES" />
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceViewModel">
                            <Button Classes="deviceCard" Margin="0,0,8,8" Click="OpenDevice">
                                <StackPanel Spacing="6">
                                    <Panel Height="110">
                                        <Image Source="{Binding Photo}" Stretch="Uniform"
                                               IsVisible="{Binding Photo, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <Image Source="/Assets/icon.png" Width="64" Height="64"
                                               IsVisible="{Binding Photo, Converter={x:Static ObjectConverters.IsNull}}" />
                                    </Panel>
                                    <TextBlock Text="{Binding Title}" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ProfileName}" FontSize="10" Classes="green" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="section" Text="▾  MODULES" Margin="0,10,0,0" />
                <WrapPanel>
                    <Button Classes="moduleCard" Margin="0,0,8,8" Click="OpenLinkedGames">
                        <StackPanel Spacing="14">
                            <Panel Width="64" Height="64">
                                <Ellipse Fill="{StaticResource GreenBrush}" />
                                <TextBlock Text="◉◉" FontSize="22" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                            <TextBlock Text="LINKED GAMES" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="moduleCard" Margin="0,0,8,8" Click="OpenMacros">
                        <StackPanel Spacing="14">
                            <Panel Width="64" Height="64">
                                <Ellipse Fill="{StaticResource GreenBrush}" />
                                <TextBlock Text="M" FontSize="30" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                            <TextBlock Text="MACRO" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="moduleCard" Margin="0,0,8,8" Click="OpenSettings">
                        <StackPanel Spacing="14">
                            <Panel Width="64" Height="64">
                                <Ellipse Fill="{StaticResource GreenBrush}" />
                                <TextBlock Text="⚙" FontSize="30" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                            <TextBlock Text="SETTINGS" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- DEVICES & MODULES: what is installed. -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowModules}">
            <StackPanel Width="760" Margin="0,10" Spacing="10">
                <TextBlock Classes="heading" Text="INSTALLED" FontSize="16" />
                <Border Background="{StaticResource PanelBrush}" Padding="0,4">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceViewModel">
                                    <Grid ColumnDefinitions="40,*,Auto" Height="44" Margin="12,0">
                                        <TextBlock Text="▦" FontSize="18" Foreground="#CCCCCC" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ShortName}" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Details}" Classes="caption" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="40,*,Auto" Height="44" Margin="12,0">
                            <Panel Width="24" Height="24"><Ellipse Fill="{StaticResource GreenBrush}" /><TextBlock Text="◉◉" FontSize="8" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" /></Panel>
                            <TextBlock Grid.Column="1" Text="Linked Games" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Version, StringFormat='Version {0}'}" Classes="caption" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="40,*,Auto" Height="44" Margin="12,0">
                            <Panel Width="24" Height="24"><Ellipse Fill="{StaticResource GreenBrush}" /><TextBlock Text="M" FontSize="12" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" /></Panel>
                            <TextBlock Grid.Column="1" Text="Macro" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Version, StringFormat='Version {0}'}" Classes="caption" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
