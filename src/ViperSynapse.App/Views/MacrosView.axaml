<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ViperSynapse.App.ViewModels"
             xmlns:bindings="using:ViperSynapse.Core.Bindings"
             x:Class="ViperSynapse.App.Views.MacrosView"
             x:DataType="vm:MacrosViewModel">
    <Grid RowDefinitions="Auto,*">
        <TextBlock Classes="title" Text="MACRO" HorizontalAlignment="Center" Margin="0,12,0,14" />

        <Grid Grid.Row="1" ColumnDefinitions="260,*,320">
            <!-- The library. -->
            <Border Background="{StaticResource SideBrush}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="12,10,6,8">
                        <TextBlock Classes="caption" Text="MACRO LIST" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="flat" Content="＋" FontSize="16" ToolTip.Tip="New macro" Command="{Binding NewMacroCommand}" />
                        <Button Grid.Column="2" Classes="flat" Content="🗑" ToolTip.Tip="Delete macro" Command="{Binding DeleteMacroCommand}" />
                    </Grid>
                    <ListBox Classes="keys" ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="bindings:Macro">
                                <TextBlock Text="{Binding Name}" Margin="14,12" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- The action list. -->
            <DockPanel Grid.Column="1" Margin="18,0,18,16" IsEnabled="{Binding HasMacro}">
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,8,0,10">
                    <TextBlock Classes="caption" Text="MACRO NAME" />
                    <TextBox Text="{Binding MacroName}" Width="320" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                    <Button Classes="cancel" Content="MOVE UP" Command="{Binding MoveUpCommand}" />
                    <Button Classes="cancel" Content="MOVE DOWN" Command="{Binding MoveDownCommand}" />
                    <Button Classes="cancel" Content="DELETE" Command="{Binding DeleteStepCommand}" />
                    <Button Classes="cancel" Content="REMOVE ALL DELAYS" Command="{Binding RemoveDelaysCommand}" />
                </StackPanel>
                <Border Background="{StaticResource PanelBrush}">
                    <ListBox Classes="keys" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:StepRow">
                                <Grid ColumnDefinitions="44,30,*" Height="30">
                                    <TextBlock Text="{Binding Number}" Foreground="#777777" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Glyph}" Foreground="#44D62C" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" VerticalAlignment="Center" Margin="6,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- Recording and inserting. -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" Padding="18" IsEnabled="{Binding HasMacro}">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="RECORD" />
                    <TextBlock Classes="caption" Text="DELAY SETTINGS" />
                    <ComboBox ItemsSource="{x:Static vm:MacrosViewModel.DelayModes}" SelectedItem="{Binding DelayMode}" HorizontalAlignment="Stretch" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding DefaultDelayVisible}">
                        <NumericUpDown Minimum="1" Maximum="10000" Value="{Binding DefaultDelayMs}" FormatString="0" Width="130" />
                        <TextBlock Text="ms" VerticalAlignment="Center" Foreground="#999999" />
                    </StackPanel>
                    <CheckBox Content="Start delay" IsChecked="{Binding UseStartDelay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding UseStartDelay}">
                        <NumericUpDown Minimum="1" Maximum="5" Value="{Binding StartDelaySeconds}" FormatString="0" Width="130" />
                        <TextBlock Text="s" VerticalAlignment="Center" Foreground="#999999" />
                    </StackPanel>
                    <Button Classes="save" Content="{Binding RecordLabel}" Command="{Binding RecordCommand}" HorizontalAlignment="Stretch" Height="34" />

                    <TextBlock Classes="heading" Text="INSERT" Margin="0,14,0,0" />
                    <TextBlock Classes="caption" Text="KEYSTROKE: CLICK, THEN PRESS A KEY" />
                    <Border Name="KeystrokeCapture" Focusable="True" Background="#1E1E1E" BorderBrush="#4A4A4A" BorderThickness="1" Height="32" Cursor="Hand">
                        <TextBlock Text="Press a key to insert it" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#999999" />
                    </Border>
                    <TextBlock Classes="caption" Text="DELAY" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumericUpDown Minimum="1" Maximum="600000" Value="{Binding InsertDelayMs}" FormatString="0" Width="130" />
                        <TextBlock Text="ms" VerticalAlignment="Center" Foreground="#999999" />
                        <Button Classes="cancel" Content="ADD" Command="{Binding AddDelayCommand}" MinWidth="60" />
                    </StackPanel>
                    <TextBlock Classes="caption" Text="TEXT OR COMMAND" />
                    <TextBox Text="{Binding InsertText}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="cancel" Content="TYPE TEXT" Command="{Binding AddTextCommand}" />
                        <Button Classes="cancel" Content="RUN COMMAND" Command="{Binding AddRunCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
