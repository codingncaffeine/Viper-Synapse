<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ViperSynapse.App.ViewModels"
             xmlns:views="using:ViperSynapse.App.Views"
             xmlns:controls="using:ViperSynapse.App.Controls"
             xmlns:bindings="using:ViperSynapse.Core.Bindings"
             x:Class="ViperSynapse.App.Views.DeviceView"
             x:DataType="vm:DeviceViewModel">
    <Grid RowDefinitions="Auto,*">
        <!-- Header, as Synapse 4 has it: profile and keymap on the left, the pages in the middle. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Height="44" Margin="0,2,0,6">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Classes="headerIcon" Text="◎" ToolTip.Tip="Profile" />
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Width="190">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="bindings:Profile"><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="flat" Content="•••" ToolTip.Tip="Profile options">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Add profile" Command="{Binding AddProfileCommand}" />
                            <MenuItem Header="Delete profile" Command="{Binding DeleteProfileCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="18,0,0,0" IsVisible="{Binding IsKeypad}">
                    <TextBlock Classes="headerIcon" Text="☰" ToolTip.Tip="Keymap" />
                    <ComboBox ItemsSource="{Binding Keymaps}" SelectedItem="{Binding SelectedKeymapItem}" Width="190">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:KeymapItem">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <Rectangle Width="14" Height="3" Fill="{Binding Color}" />
                                        <Rectangle Width="14" Height="3" Fill="{Binding Color}" />
                                        <Rectangle Width="14" Height="3" Fill="{Binding Color}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="flat" Content="•••" ToolTip.Tip="Keymap options">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Add keymap" Command="{Binding AddKeymapCommand}" />
                                <MenuItem Header="Reset this keymap to default" Command="{Binding ResetKeymapCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
            <ListBox Grid.Column="1" Classes="pills" VerticalAlignment="Center" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Spacing="14" Margin="0,0,16,0">
                <!-- The charge left, where Synapse shows it: "58 %" and a battery gauge, refreshed every minute. -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding BatteryKnown}"
                            ToolTip.Tip="Battery charge">
                    <TextBlock Text="{Binding BatteryText}" FontSize="12" Foreground="#DDDDDD" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="11" BorderBrush="#BBBBBB" BorderThickness="1" CornerRadius="2" Padding="1">
                            <Border Width="{Binding BatteryFill}" HorizontalAlignment="Left" Background="{Binding BatteryBrush}" CornerRadius="1" />
                        </Border>
                        <Border Width="2" Height="5" Background="#BBBBBB" VerticalAlignment="Center" CornerRadius="0,1,1,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Classes="caption" Text="{Binding Status}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- CUSTOMIZE -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*"
              IsVisible="{Binding SelectedPage, Converter={x:Static views:Converters.Equal}, ConverterParameter=CUSTOMIZE}">
            <Border Grid.Column="0" Width="340" Background="{StaticResource SideBrush}" IsVisible="{Binding ShowKeyList}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,12,6,8">
                        <ComboBox ItemsSource="{Binding KeyFilters}" SelectedItem="{Binding SelectedKeyFilter}" Width="142" HorizontalAlignment="Left" />
                        <Button Grid.Column="1" Classes="flat" Content="⇤" ToolTip.Tip="Hide the key list" Command="{Binding ToggleKeyListCommand}" />
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="#2A2A2A" />
                    <ScrollViewer>
                        <StackPanel Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding KeyLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KeyListLine">
                                        <Panel>
                                            <TextBlock Classes="caption" Text="{Binding Title}" Margin="16,14,0,6" FontSize="11"
                                                       IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <Grid ColumnDefinitions="*,*" IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                <ContentControl Content="{Binding Left}" />
                                                <ContentControl Grid.Column="1" Content="{Binding Right}" />
                                            </Grid>
                                        </Panel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.DataTemplates>
                                    <DataTemplate x:DataType="vm:KeyRowViewModel">
                                        <Button Classes="keyCell" Classes.selected="{Binding IsSelected}" IsEnabled="{Binding Bindable}"
                                                Command="{Binding $parent[UserControl].((vm:DeviceViewModel)DataContext).SelectKeyCommand}" CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="34,1,*">
                                                <TextBlock Text="{Binding Number}" FontSize="12" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Rectangle Grid.Column="1" Fill="#4A4A4A" Margin="0,6" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0" Spacing="0">
                                                    <TextBlock Text="{Binding ListCategory}" FontSize="8" Foreground="#8A8A8A" />
                                                    <TextBlock Text="{Binding Value}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding Changed, Converter={x:Static views:Converters.ChangedBrush}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>
                            <!-- The keypad's own buttons: their firmware decides what they do. -->
                            <ItemsControl ItemsSource="{Binding FirmwareButtons}" IsVisible="{Binding HasFirmwareButtons}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FirmwareButtonLine">
                                        <Grid ColumnDefinitions="40,1,*" Height="40" ToolTip.Tip="Handled by the device's own firmware: not remappable yet">
                                            <TextBlock Text="{Binding Where}" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Rectangle Grid.Column="1" Fill="#4A4A4A" Margin="0,6" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                                                <TextBlock Text="{Binding Category}" FontSize="8" Foreground="#8A8A8A" />
                                                <TextBlock Text="{Binding Value}" FontSize="12" Foreground="#FFFFFF" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Panel Grid.Column="1">
                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="0,0,0,20">
                        <!-- The device, and beside it what Synapse 4 puts there: the thumbstick card. -->
                        <Grid ColumnDefinitions="*,Auto" Height="560">
                            <Panel>
                                <controls:DeviceDrawing Device="{Binding}" Selected="{Binding SelectedKey}" Margin="40,10,40,10" IsVisible="{Binding ShowDrawing}" />
                                <Image Source="{Binding Photo}" Stretch="Uniform" Margin="60,20,60,20" IsVisible="{Binding !ShowDrawing}" />
                                <!-- View thumbnails, as under Synapse's device picture: the drawn layout and Razer's photo. -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,8" Spacing="8"
                                            IsVisible="{Binding Photo, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <RadioButton Classes="thumb" GroupName="view" IsChecked="{Binding !ShowPhoto, Mode=OneWay}" Click="ShowLayout" ToolTip.Tip="Key layout">
                                        <TextBlock Text="▦" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </RadioButton>
                                    <RadioButton Classes="thumb" GroupName="view" IsChecked="{Binding ShowPhoto}" ToolTip.Tip="Photo">
                                        <Image Source="{Binding Photo}" Stretch="Uniform" />
                                    </RadioButton>
                                </StackPanel>
                            </Panel>
                            <Border Grid.Column="1" Classes="card" Width="400" Margin="0,40,40,0" IsVisible="{Binding HasThumbstick}">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="heading" Text="THUMBSTICK INPUT MODE" />
                                    <TextBlock Foreground="#CCCCCC" FontSize="12" Text="Set the thumbstick to true analog, 4-way or 8-way input." />
                                    <Border CornerRadius="14" BorderBrush="#4A4A4A" BorderThickness="1" Padding="2" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Classes="segment" GroupName="stick" IsChecked="{Binding StickAnalog}" Content="◉ Analog" ToolTip.Tip="True analog" />
                                            <RadioButton Classes="segment" GroupName="stick" IsChecked="{Binding StickFourWay}" Content="✛ 4-Way" ToolTip.Tip="4-way" />
                                            <RadioButton Classes="segment" GroupName="stick" IsChecked="{Binding StickEightWay}" Content="✳ 8-Way" ToolTip.Tip="8-way" />
                                        </StackPanel>
                                    </Border>
                                    <controls:StickView Width="150" Height="150" HorizontalAlignment="Center" X="{Binding StickX}" Y="{Binding StickY}"
                                                        Directions="{Binding StickMode, Converter={x:Static views:Converters.StickDirections}}" />
                                    <TextBlock Text="{Binding StickText}" HorizontalAlignment="Center" Foreground="#CCCCCC" FontSize="12" />
                                    <TextBlock Text="{Binding StickHint}" Classes="caption" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <!-- Synapse 4's remap menu button: shows or hides the key list. -->
                            <ToggleButton Classes="remap" IsChecked="{Binding ShowKeyList}" ToolTip.Tip="Remap menu">
                                <Rectangle Width="14" Height="11" Stroke="#FFFFFF" StrokeThickness="1.5" />
                            </ToggleButton>
                            <Border CornerRadius="14" BorderBrush="#4A4A4A" BorderThickness="1" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Classes="segment" GroupName="layer" Content="Standard" IsChecked="{Binding Standard}" />
                                    <RadioButton Classes="segment" GroupName="layer" Content="Hypershift" IsChecked="{Binding Hypershift}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Setting cards under the device, as in Synapse 4. -->
                        <WrapPanel HorizontalAlignment="Center">
                            <Border Classes="card" Width="540" IsVisible="{Binding HasPollingCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="heading" Text="WIRED POLLING RATE" />
                                    <TextBlock Foreground="#CCCCCC" FontSize="12" Text="The frequency (Hz) of data updates in a second." />
                                    <ListBox Classes="rates" ItemsSource="{Binding Performance.PollRates}" SelectedItem="{Binding Performance.PollingRate}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Width="440">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="heading" Text="MACRO &amp; KEYSTROKE INTERRUPTION" />
                                    <TextBlock Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap"
                                               Text="Choose what stops a running macro or keystroke sequence." />
                                    <RadioButton GroupName="interrupt" Content="Only its own key" IsChecked="{Binding InterruptDedicated}" />
                                    <RadioButton GroupName="interrupt" Content="Any key" IsChecked="{Binding InterruptAnyKey}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Width="540" IsVisible="{Binding IsMouse}">
                                <StackPanel Spacing="10" DataContext="{Binding ScrollWheel}" x:DataType="vm:ScrollWheelViewModel">
                                    <TextBlock Classes="heading" Text="SCROLL WHEEL" />
                                    <TextBlock Text="SCROLL SPEED" Foreground="#FFFFFF" FontSize="12" />
                                    <TextBlock Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap"
                                               Text="How far each notch of the wheel scrolls: 1 is the mouse's own speed, 3 scrolls three times as far." />
                                    <controls:ValueSlider Value="{Binding LinesPerNotch}" Minimum="1" Maximum="10" />
                                    <StackPanel Spacing="10" IsVisible="{Binding $parent[UserControl].((vm:DeviceViewModel)DataContext).HasScrollFirmware}">
                                        <Border Height="1" Background="#2A2A2A" Margin="0,4" />
                                        <TextBlock Text="SCROLLING MODE" Foreground="#FFFFFF" FontSize="12" />
                                        <TextBlock Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap"
                                                   Text="Tactile, Free-Spin and Precision Tactile switch with the button below the wheel." />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="SCROLL ACCELERATION" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center" />
                                            <ToggleSwitch IsChecked="{Binding Acceleration}" OnContent="" OffContent="" MinWidth="0" Margin="0,-4,0,0" />
                                        </StackPanel>
                                        <TextBlock Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" Text="Amplifies your scrolling speed when in Free Spinning mode." />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="SMART-REEL" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center" />
                                            <ToggleSwitch IsChecked="{Binding SmartReel}" OnContent="" OffContent="" MinWidth="0" Margin="0,-4,0,0" />
                                        </StackPanel>
                                        <TextBlock Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap"
                                                   Text="Automatically switches to Free-Spin as you quickly flick the scroll wheel, and back to Tactile when the wheel stops." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Width="540" IsVisible="{Binding HasQuickRemapping}">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="heading" Text="QUICK REMAPPING" />
                                    <TextBlock Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap"
                                               Text="Map your keys to emulate gamepad controls: W, A, S and D move a virtual controller's left stick, Q and E pull its left and right triggers." />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="save" Content="APPLY TO THIS KEYMAP" Command="{Binding QuickRemapCommand}" IsVisible="{Binding !QuickRemapped}" />
                                        <Button Classes="cancel" Content="BACK TO KEYS" Command="{Binding UndoQuickRemapCommand}" IsVisible="{Binding QuickRemapped}" />
                                        <TextBlock Text="On in this keymap" Foreground="{StaticResource GreenBrush}" FontSize="12" VerticalAlignment="Center"
                                                   IsVisible="{Binding QuickRemapped}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- The binding flyout, against the key list as in Synapse. -->
                <views:BindingFlyout DataContext="{Binding Editor}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Margin="0,0,0,0" IsVisible="{Binding $parent[UserControl].((vm:DeviceViewModel)DataContext).Editor, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Panel>
        </Grid>

        <!-- LIGHTING -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding SelectedPage, Converter={x:Static views:Converters.Equal}, ConverterParameter=LIGHTING}">
            <WrapPanel HorizontalAlignment="Center" Margin="20,8" DataContext="{Binding Lighting}" x:DataType="vm:LightingViewModel">
                <!-- Left column: Brightness, Switch off lighting. -->
                <StackPanel>
                    <Border Classes="card" Width="440">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="heading" Text="BRIGHTNESS" VerticalAlignment="Center" />
                                <ToggleSwitch IsChecked="{Binding LightingOn}" OnContent="" OffContent="" MinWidth="0" Margin="0,-4,0,0" />
                            </StackPanel>
                            <controls:ValueSlider Value="{Binding Brightness}" Minimum="0" Maximum="100" IsEnabled="{Binding LightingOn}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="card" Width="440">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="heading" Text="SWITCH OFF LIGHTING" />
                            <CheckBox Content="When display is turned off" IsChecked="{Binding OffWhenDisplayOff}" />
                            <CheckBox Content="When idle for (minutes)" IsChecked="{Binding OffWhenIdle}" />
                            <controls:ValueSlider Value="{Binding IdleMinutes}" Minimum="1" Maximum="15" IsEnabled="{Binding OffWhenIdle}" Margin="26,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Classes="card" Width="440">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="heading" Text="EFFECTS" />
                        <ListBox Classes="segmentList" ItemsSource="{x:Static vm:LightingViewModel.EffectTabs}" SelectedItem="{Binding EffectTab}"
                                 IsVisible="{Binding HasFrame}" HorizontalAlignment="Left">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <TextBlock Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding ShowQuick}"
                                   Text="Quick effects are presets that are saved to the device's profile and can be applied to your other Razer devices." />
                        <TextBlock Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !ShowQuick}"
                                   Text="Advanced effects give every key its own colour: paint them below." />
                        <StackPanel Spacing="8" IsVisible="{Binding HasZones}">
                            <CheckBox Content="Same effect on every zone" IsChecked="{Binding SyncAll}" />
                            <TextBlock Classes="caption" Text="ZONE" />
                            <ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding Converter={x:Static views:Converters.ZoneLabel}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding ShowQuick}">
                            <ComboBox ItemsSource="{Binding QuickEffects}" SelectedItem="{Binding SelectedEffect}" Width="200" />
                            <Button Classes="link" Content="Apply to other devices" Command="{Binding ApplyToOtherDevicesCommand}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding ColorModes}" SelectedItem="{Binding SelectedColorMode}" HorizontalAlignment="Stretch" IsVisible="{Binding ShowModes}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ColorPicker Color="{Binding Color1}" IsVisible="{Binding ShowColor1}" />
                            <ColorPicker Color="{Binding Color2}" IsVisible="{Binding ShowColor2}" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding ShowSpeed}">
                            <TextBlock Classes="caption" Text="SPEED" />
                            <Slider Minimum="1" Maximum="3" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Speed}" />
                        </StackPanel>
                        <CheckBox Content="Reverse direction" IsChecked="{Binding Reverse}" IsVisible="{Binding ShowDirection}" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Width="780" IsVisible="{Binding ShowFrameEditor}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="heading" Text="PER-KEY COLOURS" />
                        <TextBlock Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                                   Text="Pick a colour, then click the keys to paint them. The keypad shows it as you go." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ColorPicker Color="{Binding PaintColor}" />
                            <Button Classes="cancel" Content="FILL ALL" Command="{Binding FillAllCommand}" />
                            <Button Classes="cancel" Content="ALL OFF" Command="{Binding AllOffCommand}" />
                        </StackPanel>
                        <controls:DeviceDrawing Name="PaintCanvas" Height="460" IsVisible="{Binding ShowKeyCanvas}"
                                                Device="{Binding $parent[UserControl].((vm:DeviceViewModel)DataContext)}"
                                                PaintColors="{Binding KeyColors}" />
                        <ItemsControl ItemsSource="{Binding Cells}" IsVisible="{Binding ShowLedGrid}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="{Binding GridColumns}" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LedCell">
                                    <Button Width="44" Height="44" Margin="3" Background="{Binding Brush}" CornerRadius="6"
                                            BorderBrush="#3A3A3A" BorderThickness="1" Click="PaintCell" ToolTip.Tip="LED" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>

        <!-- PERFORMANCE -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding SelectedPage, Converter={x:Static views:Converters.Equal}, ConverterParameter=PERFORMANCE}">
            <WrapPanel HorizontalAlignment="Center" Margin="20,8" DataContext="{Binding Performance}" x:DataType="vm:PerformanceViewModel">
                <Border Classes="card" Width="620">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="heading" Text="SENSITIVITY" />
                        <TextBlock Foreground="#CCCCCC" FontSize="12" Text="The number of dots-per-inch (DPI) of mouse movement." />
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasStages}">
                            <TextBlock Text="Sensitivity Stages" VerticalAlignment="Center" />
                            <ToggleSwitch IsChecked="{Binding StagesEnabled}" OnContent="" OffContent="" MinWidth="0" />
                            <Button Classes="flat" Content="＋" ToolTip.Tip="Add a stage" Command="{Binding AddStageCommand}" IsVisible="{Binding StagesEnabled}" />
                            <Button Classes="flat" Content="－" ToolTip.Tip="Remove the last stage" Command="{Binding RemoveStageCommand}" IsVisible="{Binding StagesEnabled}" />
                        </StackPanel>
                        <CheckBox Content="Enable X-Y sensitivity" IsChecked="{Binding SeparateXY}" />
                        <!-- The range once, above the stages, as Synapse shows it. -->
                        <Grid ColumnDefinitions="44,70,*">
                            <TextBlock Grid.Column="1" Text="DPI" Classes="caption" />
                            <Grid Grid.Column="2" Margin="12,0,0,0">
                                <TextBlock Text="100" Classes="caption" />
                                <TextBlock Text="{Binding DpiMax}" Classes="caption" HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Stages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StageRow">
                                    <Grid ColumnDefinitions="44,70,*" RowDefinitions="Auto,Auto" Margin="0,4">
                                        <Button Classes="stage" Content="{Binding Number}" Classes.active="{Binding Active}" Click="ActivateStage" VerticalAlignment="Top" />
                                        <NumericUpDown Grid.Column="1" Value="{Binding X}" Minimum="100" Increment="50" FormatString="0" ShowButtonSpinner="False"
                                                       Maximum="{Binding DpiMax}" VerticalAlignment="Top" />
                                        <controls:ValueSlider Grid.Column="2" Value="{Binding X}" Minimum="100" Maximum="{Binding DpiMax}" Step="50"
                                                              ShowBubble="False" ShowLabels="False" Margin="12,0,0,0" />
                                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Y}" Minimum="100" Increment="50" FormatString="0" ShowButtonSpinner="False"
                                                       Maximum="{Binding DpiMax}" IsVisible="{Binding SeparateXY}" VerticalAlignment="Top" />
                                        <controls:ValueSlider Grid.Row="1" Grid.Column="2" Value="{Binding Y}" Minimum="100" Maximum="{Binding DpiMax}" Step="50"
                                                              ShowBubble="False" ShowLabels="False" Margin="12,0,0,0" IsVisible="{Binding SeparateXY}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Classes="card" Width="440">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="heading" Text="WIRED POLLING RATE" />
                        <TextBlock Foreground="#CCCCCC" FontSize="12" Text="The frequency (Hz) of data updates in a second." />
                        <ListBox Classes="rates" ItemsSource="{Binding PollRates}" SelectedItem="{Binding PollingRate}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>

        <!-- CALIBRATION -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding SelectedPage, Converter={x:Static views:Converters.Equal}, ConverterParameter=CALIBRATION}">
            <StackPanel HorizontalAlignment="Center" Margin="20,8" Spacing="12" DataContext="{Binding Calibration}" x:DataType="vm:CalibrationViewModel">
                <Border Background="#2A2A2A" Padding="20,14" Width="900">
                    <StackPanel Spacing="6">
                        <TextBlock Text="MOUSE MAT SURFACE CALIBRATION" Foreground="{StaticResource GreenBrush}" FontSize="22" HorizontalAlignment="Center" />
                        <TextBlock Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Your mouse tracks accurately out of the box. For another level of precision, set the distance at which it stops tracking when you lift it." />
                    </StackPanel>
                </Border>
                <Border Classes="card" Width="520" HorizontalAlignment="Left">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="heading" Text="SMART TRACKING" VerticalAlignment="Center" />
                            <ToggleSwitch IsChecked="{Binding SmartTracking}" OnContent="" OffContent="" MinWidth="0" Margin="0,-4,0,0" />
                        </StackPanel>
                        <TextBlock Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap"
                                   Text="Set a single cut-off point at your preferred distance, whatever the surface. Off leaves the sensor at its own default." />
                        <TextBlock Classes="caption" Text="TRACKING DISTANCE" />
                        <controls:ValueSlider Value="{Binding Distance}" Minimum="0" Maximum="2" Step="1" ShowBubble="False"
                                              MinLabel="LOW" MidLabel="MEDIUM" MaxLabel="HIGH" IsEnabled="{Binding SmartTracking}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- POWER -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding SelectedPage, Converter={x:Static views:Converters.Equal}, ConverterParameter=POWER}">
            <WrapPanel HorizontalAlignment="Center" Margin="20,8" DataContext="{Binding Power}" x:DataType="vm:PowerViewModel">
                <Border Classes="card" Width="440">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="heading" Text="WIRELESS POWER SAVING" />
                        <TextBlock Foreground="#CCCCCC" FontSize="12" Text="Enter sleep mode if idle for (minutes)" />
                        <controls:ValueSlider Value="{Binding SleepMinutes}" Minimum="1" Maximum="15" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Width="440">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="heading" Text="LOW POWER MODE" />
                        <TextBlock Foreground="#CCCCCC" FontSize="12" Text="When wireless, enter Low Power Mode if the battery level is below (%)" TextWrapping="Wrap" />
                        <controls:ValueSlider Value="{Binding LowBattery}" Minimum="5" Maximum="100" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
