<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that is not hardware or windows: the Razer report format, the device catalogue,
       profiles, key bindings and macros. No I/O here, so all of it runs in the tests. -->
  <PropertyGroup>
    <RootNamespace>ViperSynapse.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ViperSynapse.Tests" />
  </ItemGroup>

  <!-- The device catalogue is built into the assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\*.json" LogicalName="data/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
